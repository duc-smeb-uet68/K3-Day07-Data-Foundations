# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: direct OpenAI embedding configuration (not needed with local embeddings)
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter LLM configuration
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost
# OPENROUTER_APP_NAME=K3-Day07-Data-Foundations

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
